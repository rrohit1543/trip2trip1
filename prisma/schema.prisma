// TripMandi Admin Portal & Logistics Engine Schema
// Database: PostgreSQL

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  OPERATOR
  CUSTOMER
}

enum TripType {
  DIRECT
  CONNECTED
}

enum TripStatus {
  DRAFT
  ACTIVE
  SOLD_OUT
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

model User {
  id        String    @id @default(uuid())
  name      String?
  email     String    @unique
  phone     String?
  role      Role      @default(CUSTOMER)
  bookings  Booking[]
  createdAt DateTime  @default(now())
}

model Trip {
  id          String     @id @default(uuid())
  title       String
  slug        String     @unique
  description String
  tripType    TripType   @default(DIRECT)
  basePrice   Float
  images      String[]
  itinerary   Json
  legs        TripLeg[]
  bookings    Booking[]
  status      TripStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
}

model TripLeg {
  id            String      @id @default(uuid())
  tripId        String
  trip          Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  sequenceOrder Int
  origin        String
  destination   String
  departureTime DateTime
  arrivalTime   DateTime
  busId         String?
  bus           Bus?        @relation(fields: [busId], references: [id], onDelete: SetNull)
  driverId      String?
  driver        Driver?     @relation(fields: [driverId], references: [id], onDelete: SetNull)
}

model Contractor {
  id            String   @id @default(uuid())
  companyName   String
  contactPerson String
  phone         String
  email         String?
  gstNumber     String?
  buses         Bus[]
  drivers       Driver[]
  createdAt     DateTime @default(now())
}

model Driver {
  id            String      @id @default(uuid())
  name          String
  phone         String
  licenseNumber String
  contractorId  String?
  contractor    Contractor? @relation(fields: [contractorId], references: [id], onDelete: SetNull)
  tripLegs      TripLeg[]
  createdAt     DateTime    @default(now())
}

model Bus {
  id           String      @id @default(uuid())
  busNumber    String      @unique
  model        String
  busType      String // Sleeper, Semi-Sleeper, Seater
  seatCapacity Int
  seatLayout   Json
  contractorId String?
  contractor   Contractor? @relation(fields: [contractorId], references: [id], onDelete: SetNull)
  tripLegs     TripLeg[]
  createdAt    DateTime    @default(now())
}

model Booking {
  id            String        @id @default(uuid())
  pnr           String        @unique
  tripId        String
  trip          Trip          @relation(fields: [tripId], references: [id], onDelete: Restrict)
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  seatsBooked   String[]
  totalAmount   Float
  paymentStatus PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum PostCategory {
  TRIP_UPDATE
  NEWS
  ANNOUNCEMENT
  OFFERS
  FLEET_ALERT
}

enum MediaType {
  IMAGE
  VIDEO
}

model Post {
  id        String      @id @default(uuid())
  title     String
  content   String
  category  PostCategory @default(TRIP_UPDATE)
  status    PostStatus   @default(PUBLISHED)
  isPinned  Boolean      @default(false)
  authorId  String
  media     PostMedia[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model PostMedia {
  id           String    @id @default(uuid())
  postId       String
  post         Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  mediaType    MediaType @default(IMAGE)
  url          String
  thumbnailUrl String?
  orderIndex   Int       @default(0)
}

