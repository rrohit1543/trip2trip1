// Prisma Schema for RedBus-style Dynamic Trip Generation & Interactive Seat Pricing System
// Database: PostgreSQL

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum VehicleType {
  BUS
  CAR
  TRAVELLER
}

enum SeatType {
  SEATER
  SLEEPER_UPPER
  SLEEPER_LOWER
}

enum SeatStatus {
  AVAILABLE
  FEMALE_ONLY
  BLOCKED
  BOOKED
}

enum DeckType {
  LOWER
  UPPER
}

model Vehicle {
  id             String      @id @default(uuid())
  name           String
  registrationNo String      @unique
  type           VehicleType @default(BUS)
  totalSeats     Int         @default(36)
  templateLayout Json        // Grid configuration (rows, cols, decks, seat mapping)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  trips          Trip[]

  @@map("vehicles")
}

model Route {
  id                String   @id @default(uuid())
  source            String
  destination       String
  intermediateStops Json     // Array of stops: [{ name: "Ambala", distanceKm: 200, priceModifierPct: 40 }]
  distanceKm        Float    @default(500)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  trips             Trip[]

  @@map("routes")
}

model Trip {
  id                  String        @id @default(uuid())
  routeId             String
  vehicleId           String
  departureTime       DateTime
  arrivalTime         DateTime
  basePrice           Float
  dynamicSurgeEnabled Boolean       @default(true)
  surgeThresholdPct   Float         @default(75.0) // Auto surge when occupancy > 75%
  surgeIncreasePct    Float         @default(15.0) // +15% price increase
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  route               Route         @relation(fields: [routeId], references: [id], onDelete: Cascade)
  vehicle             Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  seatPricings        SeatPricing[]

  @@map("trips")
}

model SeatPricing {
  id            String     @id @default(uuid())
  tripId        String
  seatNumber    Int
  seatLabel     String     // e.g. "L1", "U5", "1A"
  priceOverride Float?     // Optional custom price override
  seatType      SeatType   @default(SEATER)
  status        SeatStatus @default(AVAILABLE)
  deck          DeckType   @default(LOWER)
  row           Int        @default(1)
  col           Int        @default(1)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  trip          Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, seatNumber])
  @@map("seat_pricings")
}
